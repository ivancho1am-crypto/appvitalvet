# Puerto del servidor (Railway lo inyecta automáticamente)
PORT=3000

# Supabase — la anon key es pública por diseño (Row Level Security en Supabase controla acceso)
# Copia estos valores desde tu proyecto en supabase.com > Settings > API
SUPABASE_URL=https://wjzxdevrnzvgklapolve.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui

# Clave admin de VitaBot — NUNCA exponerla en el frontend.
# Debe ser idéntica a ADMIN_API_KEY configurada en el servicio vitabot-vitalvet de Railway.
# El servidor la usa para autenticar el proxy POST /api/sync-patient -> VitaBot /api/crm/sync-patient
VITABOT_ADMIN_KEY=tu_admin_api_key_aqui
